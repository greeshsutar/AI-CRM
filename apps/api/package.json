{
  "name": "@minstocs/api",
  "version": "0.0.0",
  "private": true,
  "description": "MINSTOCS CRM — NestJS API",
  "license": "PROPRIETARY",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  }
}
