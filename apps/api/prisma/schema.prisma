// Prisma schema for MINSTOCS CRM
// Location: apps/api/prisma/schema.prisma (authoritative, single source of truth)
//
// PHASE 1 NOTE:
// This schema contains only the minimum technically required structure.
// No CRM business models (contacts, companies, deals, etc.) are defined.
// Business models will be added in their respective implementation phases.
//
// DATABASE STATUS:
// VERIFIED — Supabase PostgreSQL connection successfully established. The database is intentionally empty because Phase 1 prohibits CRM business tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  CUSTOMER_ADMIN
  MANAGER
  AGENT
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id                  String       @id @db.Uuid
  email               String       @unique
  firstName           String?
  lastName            String?
  avatarUrl           String?
  phone               String?
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  memberships         Membership[]
  auditLogs           AuditLog[]   @relation("UserAuditLogs")
  teamMemberships     TeamMember[]
  invitationsSent     Invitation[] @relation("InviterInvitations")
  invitationsAccepted Invitation[] @relation("AcceptedUserInvitations")

  @@map("users")
}

model Organization {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  slug          String             @unique
  domain        String?
  numberOfUsers Int?
  status        OrganizationStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  memberships   Membership[]
  auditLogs     AuditLog[]
  teams         Team[]
  invitations   Invitation[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           Role             @default(AGENT)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @db.Uuid
  organizationId String?  @db.Uuid
  action         String
  targetResource String?
  metadata       Json?
  createdAt      DateTime @default(now())

  actor        User?         @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  firstName      String?
  lastName       String?
  role           Role             @default(AGENT)
  inviterId      String           @db.Uuid
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InviterInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedUser User?        @relation("AcceptedUserInvitations", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@index([status])
  @@map("invitations")
}




